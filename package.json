  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "vue-eslint-parser": "^10.4.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true
  }
}
