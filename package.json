{
  "name": "booking",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "e2e"
  ],
  "scripts": {
    "lint": "eslint .",
    "test": "npm run lint && npm test --workspace=backend && npm test --workspace=frontend",
